# MOCK-001-A: Mock测试控制配置模板
#
# 使用说明：
# 1. 复制此文件为 .env.test
# 2. 根据需要修改配置值
# 3. source .env.test 后运行测试

# ================================
# 测试模式控制
# ================================

# AEP测试模式配置
# - real: 使用真实AEP API（需要有效的认证信息）
# - mock: 使用Mock配置进行测试（默认）
# - skip: 跳过所有AEP API相关测试
AEP_TEST_MODE=mock

# ================================
# Mock配置开关
# ================================

# 是否启用Mock测试
ENABLE_MOCK_TESTS=true

# 是否启用配置污染检测
ENABLE_POLLUTION_DETECTION=true

# 测试后是否自动清理系统属性
TEST_CLEANUP_ENABLED=true

# ================================
# 真实环境配置（当AEP_TEST_MODE=real时使用）
# ================================

# 请设置您的真实AEP认证信息
# AEP_APP_KEY=your_real_app_key
# AEP_APP_SECRET=your_real_app_secret
# AEP_API_HOST=your_tenant_id.api.ctwing.cn
# AEP_APP_ID=your_app_id

# ================================
# 调试选项
# ================================

# 是否启用详细日志
TEST_DEBUG_MODE=false

# 测试超时时间（秒）
TEST_TIMEOUT=30

# 是否保留测试输出文件
KEEP_TEST_OUTPUTS=false