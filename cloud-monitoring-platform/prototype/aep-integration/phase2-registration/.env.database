# AEP Integration 数据库环境变量 - 本地开发环境
# 基于 .env.database.template 创建

# ==================== 本地MySQL服务器配置 ====================
# MySQL服务器连接信息
DB_HOST=localhost
DB_PORT=3306
DB_NAME=aep_integration_db

# 数据库认证信息 (本地开发环境)
DB_USERNAME=aep_user
DB_PASSWORD=aep_password_2026

# 管理员账户 (用于数据库初始化)
DB_ADMIN_USER=root
DB_ADMIN_PASSWORD=""

# ==================== 连接池配置 (本地优化) ====================
# 连接池大小 (本地连接可以适中)
DB_POOL_SIZE=10
DB_MIN_IDLE=2

# 超时配置 (本地连接较快)
DB_CONNECTION_TIMEOUT=30000
DB_IDLE_TIMEOUT=600000
DB_MAX_LIFETIME=1800000

# ==================== SSL安全配置 ====================
# 本地开发可以禁用SSL
DB_USE_SSL=false
DB_SSL_MODE=DISABLED

# ==================== 性能优化配置 ====================
# 启用预编译语句缓存
DB_USE_SERVER_PREP_STMTS=true
DB_CACHE_PREP_STMTS=true
DB_PREP_STMT_CACHE_SIZE=250

# 启用批量重写
DB_REWRITE_BATCHED_STATEMENTS=true

# 本地开发不需要压缩
DB_USE_COMPRESSION=false

# ==================== 网络超时配置 ====================
DB_SOCKET_TIMEOUT=30000
DB_CONNECT_TIMEOUT=10000

# ==================== 连接验证配置 ====================
# 本地连接配置
DB_TEST_ON_BORROW=true
DB_TEST_WHILE_IDLE=true
DB_VALIDATION_INTERVAL=30000

# ==================== 字符集和时区 ====================
# MySQL 9.6 推荐使用 utf8mb4
DB_CHARACTER_ENCODING=utf8mb4
DB_USE_UNICODE=true
DB_SERVER_TIMEZONE=Asia/Shanghai
# MySQL 9.6 新增的字符集选项
DB_COLLATION=utf8mb4_0900_ai_ci

# ==================== 数据库迁移配置 ====================
DB_ENABLE_MIGRATION=true
DB_MIGRATION_BASELINE_ON_MIGRATE=true

# ==================== 监控配置 ====================
DB_LOG_SLOW_QUERIES=true
DB_SLOW_QUERY_THRESHOLD=1000

# ==================== 开发环境特殊配置 ====================
# 启用详细日志
DB_LOG_SQL=true
DB_LOG_SLOW_SQL=true