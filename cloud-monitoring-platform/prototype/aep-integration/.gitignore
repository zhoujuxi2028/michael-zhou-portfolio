# AEP集成项目 Git忽略文件

# ====================================
# 敏感配置文件
# ====================================

# 全局环境变量配置文件
.env.global

# 各Phase的环境变量配置文件
phase*/.env
phase*/config/.env

# 任何包含凭据的文件
*credentials*
*secret*
*password*
*.key
*.pem

# ====================================
# 编译输出
# ====================================

# Java编译生成的class文件
*.class

# JAR文件（除了依赖库）
*.jar
!lib/*.jar
!phase*/lib/*.jar

# ====================================
# IDE和编辑器文件
# ====================================

# IntelliJ IDEA
.idea/
*.iml
*.iws
*.ipr

# Eclipse
.project
.classpath
.metadata/
.settings/

# Visual Studio Code
.vscode/

# ====================================
# 系统文件
# ====================================

# macOS
.DS_Store
.DS_Store?
._*

# Windows
Thumbs.db
ehthumbs.db
Desktop.ini

# Linux
*~

# ====================================
# 日志和临时文件
# ====================================

*.log
logs/
*.tmp
*.temp
*.swp
*.swo

# ====================================
# 备份文件
# ====================================

*.bak
*.backup
*~

# ====================================
# Phase特定忽略
# ====================================

# Phase 4 前端构建输出
phase4-ui/frontend/dist/
phase4-ui/frontend/node_modules/

# Phase 4 后端构建输出
phase4-ui/backend/target/

# ====================================
# 说明
# ====================================

# 注意：
# - .env.template 文件应该被提交（作为配置模板）
# - .env 和 .env.global 文件绝对不能提交（包含真实认证信息）
# - 各Phase的lib目录中的jar文件会被提交（依赖库）