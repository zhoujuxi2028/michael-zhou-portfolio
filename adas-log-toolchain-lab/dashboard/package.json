{
  "name": "adas-dashboard",
  "version": "0.1.0",
  "description": "Static ECharts dashboard for ADAS log toolchain summary.json (synthetic data only)",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "echarts": "6.1.0",
    "eslint": "10.15.0",
    "typescript": "5.9.3",
    "typescript-eslint": "8.73.0",
    "vite": "8.3.8",
    "vitest": "5.1.1",
    "yaml": "2.9.1"
  }
}
