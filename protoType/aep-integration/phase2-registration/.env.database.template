# AEP Integration 数据库环境变量模板
# 复制为 .env.database 并填入真实配置

# ==================== 远程MySQL服务器配置 ====================
# MySQL服务器连接信息
DB_HOST=your-mysql-server.example.com
DB_PORT=3306
DB_NAME=aep_integration_db

# 数据库认证信息 (请替换为真实值)
DB_USERNAME=aep_user
DB_PASSWORD=your_secure_password_here

# ==================== 连接池配置 (远程优化) ====================
# 连接池大小 (远程连接建议较小)
DB_POOL_SIZE=8
DB_MIN_IDLE=2

# 超时配置 (远程连接需要更长时间)
DB_CONNECTION_TIMEOUT=60000
DB_IDLE_TIMEOUT=300000
DB_MAX_LIFETIME=1200000

# ==================== SSL安全配置 ====================
# 生产环境强烈建议启用
DB_USE_SSL=true
DB_SSL_MODE=REQUIRED

# SSL证书路径 (如果需要客户端证书)
# DB_SSL_CERT_PATH=/path/to/client-cert.pem
# DB_SSL_KEY_PATH=/path/to/client-key.pem
# DB_SSL_CA_PATH=/path/to/ca-cert.pem

# ==================== 性能优化配置 ====================
# 启用预编译语句缓存
DB_USE_SERVER_PREP_STMTS=true
DB_CACHE_PREP_STMTS=true
DB_PREP_STMT_CACHE_SIZE=250

# 启用批量重写
DB_REWRITE_BATCHED_STATEMENTS=true

# 启用压缩 (远程连接推荐)
DB_USE_COMPRESSION=true

# ==================== 网络超时配置 ====================
DB_SOCKET_TIMEOUT=30000
DB_CONNECT_TIMEOUT=10000

# ==================== 连接验证配置 ====================
# 远程连接重要配置
DB_TEST_ON_BORROW=true
DB_TEST_WHILE_IDLE=true
DB_VALIDATION_INTERVAL=30000

# ==================== 字符集和时区 ====================
DB_CHARACTER_ENCODING=utf8mb3
DB_USE_UNICODE=true
DB_SERVER_TIMEZONE=Asia/Shanghai

# ==================== 数据库迁移配置 ====================
DB_ENABLE_MIGRATION=true
DB_MIGRATION_BASELINE_ON_MIGRATE=true

# ==================== 监控配置 ====================
DB_LOG_SLOW_QUERIES=true
DB_SLOW_QUERY_THRESHOLD=2000

# ==================== 高可用配置 (可选) ====================
# 如果使用MySQL主从或集群
# DB_FAILOVER_READ_ONLY=false
# DB_AUTO_RECONNECT=true
# DB_MAX_RECONNECTS=3

# 如果使用读写分离
# DB_READ_HOST=read-replica.example.com
# DB_READ_PORT=3306