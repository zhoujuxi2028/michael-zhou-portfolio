# AEP产品注册工具环境变量配置模板
# 复制此文件为 .env 并填入真实的配置信息

# =====================================
# AEP平台基础认证信息（必需）
# =====================================

# AEP应用密钥
AEP_APP_KEY=your_app_key_here

# AEP应用秘钥
AEP_APP_SECRET=your_app_secret_here

# AEP API主机（格式：tenant_id.api.ctwing.cn）
AEP_API_HOST=your_tenant_id.api.ctwing.cn

# AEP应用ID
AEP_APP_ID=your_app_id_here

# =====================================
# 可选配置
# =====================================

# 默认租户ID（可选）
AEP_DEFAULT_TENANT_ID=your_tenant_id

# 操作超时时间（毫秒，默认30000）
AEP_OPERATION_TIMEOUT=30000

# 最大重试次数（默认3）
AEP_MAX_RETRIES=3

# 启用调试模式（true/false，默认false）
AEP_DEBUG_MODE=false

# 启用审计日志（true/false，默认true）
AEP_ENABLE_AUDIT_LOG=true

# =====================================
# Java虚拟机配置
# =====================================

# JVM堆内存设置
JAVA_HEAP_SIZE=-Xmx512m

# JVM其他参数
JAVA_OPTS=-Dfile.encoding=UTF-8 -Duser.timezone=Asia/Shanghai

# =====================================
# 使用说明
# =====================================
# 1. 将此文件复制为 .env
# 2. 替换上述 your_* 占位符为真实值
# 3. 运行脚本会自动加载这些环境变量
# 4. 不要将包含真实凭据的 .env 文件提交到版本控制