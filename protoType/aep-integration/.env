# AEP集成项目全局环境变量配置
# 用于所有Phase的通用配置

# ====================================
# AEP平台基础认证信息
# ====================================

# 您的应用Key（请填入实际值）
AEP_APP_KEY=YOUR_APP_KEY_HERE

# 您的应用Secret（请填入实际值）
AEP_APP_SECRET=YOUR_APP_SECRET_HERE

# 您的应用接入域名（请填入实际值）
AEP_API_HOST=your-app-id.api.ctwing.cn

# 您的应用ID（请填入实际值）
AEP_APP_ID=YOUR_APP_ID_HERE

# ====================================
# 产品和设备信息
# ====================================

# 产品MasterKey（用于设备管理，请填入实际值）
AEP_MASTER_KEY=YOUR_MASTER_KEY_HERE

# 默认产品ID（请填入实际值）
AEP_PRODUCT_ID=YOUR_PRODUCT_ID_HERE

# ====================================
# 项目配置
# ====================================

# 项目根目录（请修改为您的实际路径）
AEP_PROJECT_ROOT=/path/to/your/project/aep-integration

# 当前开发阶段
CURRENT_PHASE=phase1-query

# ====================================
# 安全提醒
# ====================================

# 重要：
# - 此文件包含敏感认证信息
# - 请确保在 .gitignore 中
# - 不要在任何公开场所分享此文件内容
# - 使用前请填入您的实际配置值