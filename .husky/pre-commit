#!/bin/sh

STAGED=$(git diff --cached --name-only)

# Use Java 17 for Android Gradle tasks on macOS
if command -v /usr/libexec/java_home >/dev/null 2>&1; then
  JAVA_HOME=$(/usr/libexec/java_home -v 17 2>/dev/null)
  export JAVA_HOME
fi

# Python: flake8 on edi-reporting-demo
if echo "$STAGED" | grep -q "^edi-reporting-demo/"; then
  echo "→ flake8: edi-reporting-demo"
  (cd edi-reporting-demo && python3 -m flake8 edi/ \
    --max-line-length=100 \
    --exclude=edi/__pycache__,edi/tests/__pycache__ \
    --extend-ignore=E501)
fi

# Android compose: lint
if echo "$STAGED" | grep -q "^android-testing-demo-compose/"; then
  echo "→ lint: android-testing-demo-compose"
  (cd android-testing-demo-compose && ./gradlew lint --quiet)
fi

# Android view: lint
if echo "$STAGED" | grep -q "^android-testing-demo-view/"; then
  echo "→ lint: android-testing-demo-view"
  (cd android-testing-demo-view && ./gradlew lint --quiet)
fi

# devops-platform-demo: ESLint
if echo "$STAGED" | grep -q "^devops-platform-demo/"; then
  echo "→ lint: devops-platform-demo"
  (cd devops-platform-demo && npm run lint --if-present)
fi

# adas-log-toolchain-lab: lint + typecheck
if echo "$STAGED" | grep -q "^adas-log-toolchain-lab/"; then
  echo "→ lint: adas-log-toolchain-lab"
  (cd adas-log-toolchain-lab && npm run lint && npm run typecheck)
fi

# adas-log-toolchain-lab/analysis: flake8 (skipped if flake8 is not installed locally; CI always runs it)
if echo "$STAGED" | grep -q "^adas-log-toolchain-lab/analysis/"; then
  if python3 -m flake8 --version >/dev/null 2>&1; then
    echo "→ flake8: adas-log-toolchain-lab/analysis"
    (cd adas-log-toolchain-lab/analysis && python3 -m flake8 --max-line-length 100 .)
  else
    echo "→ flake8 not installed, skipping adas-log-toolchain-lab/analysis (CI runs it)"
  fi
fi

# adas-log-toolchain-lab/dashboard: lint + typecheck
if echo "$STAGED" | grep -q "^adas-log-toolchain-lab/dashboard/"; then
  echo "→ lint: adas-log-toolchain-lab/dashboard"
  (cd adas-log-toolchain-lab/dashboard && npm run lint && npm run typecheck)
fi
