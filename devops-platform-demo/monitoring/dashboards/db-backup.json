{
  "annotations": {
    "list": [
      {
        "builtIn": 1,
        "datasource": "-- Grafana --",
        "enable": true,
        "hide": true,
        "iconColor": "rgba(0, 211, 255, 1)",
        "name": "Annotations & Alerts",
        "type": "dashboard"
      }
    ]
  },
  "editable": true,
  "gnetId": null,
  "graphTooltip": 0,
  "id": null,
  "links": [],
  "panels": [
    {
      "datasource": "Prometheus",
      "description": "最近一次 db-backup 运行结果（backup_last_status）",
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": { "text": "失败", "color": "red" },
                "1": { "text": "成功", "color": "green" }
              }
            }
          ],
          "thresholds": { "mode": "absolute", "steps": [ { "color": "red", "value": null }, { "color": "green", "value": 1 } ] },
          "unit": "short"
        },
        "overrides": []
      },
      "gridPos": { "h": 6, "w": 6, "x": 0, "y": 0 },
      "id": 1,
      "options": { "colorMode": "background", "graphMode": "none", "justifyMode": "auto", "orientation": "auto", "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false }, "textMode": "auto" },
      "pluginVersion": "8.0.0",
      "targets": [ { "expr": "backup_last_status{job=\"db_backup\"}", "legendFormat": "{{instance}}", "refId": "A" } ],
      "title": "最近备份状态",
      "type": "stat"
    },
    {
      "datasource": "Prometheus",
      "description": "距最近一次成功备份的时间；超过 26h 触发 BackupStale",
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "mappings": [],
          "thresholds": { "mode": "absolute", "steps": [ { "color": "green", "value": null }, { "color": "red", "value": 93600 } ] },
          "unit": "s"
        },
        "overrides": []
      },
      "gridPos": { "h": 6, "w": 6, "x": 6, "y": 0 },
      "id": 2,
      "options": { "colorMode": "value", "graphMode": "none", "justifyMode": "auto", "orientation": "auto", "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false }, "textMode": "auto" },
      "pluginVersion": "8.0.0",
      "targets": [ { "expr": "time() - backup_last_success_timestamp{job=\"db_backup\"}", "legendFormat": "{{instance}}", "refId": "A" } ],
      "title": "距上次成功备份",
      "type": "stat"
    },
    {
      "datasource": "Prometheus",
      "description": "最近一次恢复演练结果（restore_last_status）",
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": { "text": "失败", "color": "red" },
                "1": { "text": "通过", "color": "green" }
              }
            }
          ],
          "thresholds": { "mode": "absolute", "steps": [ { "color": "red", "value": null }, { "color": "green", "value": 1 } ] },
          "unit": "short"
        },
        "overrides": []
      },
      "gridPos": { "h": 6, "w": 6, "x": 12, "y": 0 },
      "id": 3,
      "options": { "colorMode": "background", "graphMode": "none", "justifyMode": "auto", "orientation": "auto", "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false }, "textMode": "auto" },
      "pluginVersion": "8.0.0",
      "targets": [ { "expr": "restore_last_status{job=\"db_restore_drill\"}", "legendFormat": "{{instance}}", "refId": "A" } ],
      "title": "最近恢复演练",
      "type": "stat"
    },
    {
      "datasource": "Prometheus",
      "description": "近 7 天 backup_last_status 的时间加权均值（≈ 成功状态占比，非按次统计）",
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "mappings": [],
          "max": 1,
          "min": 0,
          "thresholds": { "mode": "absolute", "steps": [ { "color": "red", "value": null }, { "color": "yellow", "value": 0.9 }, { "color": "green", "value": 0.99 } ] },
          "unit": "percentunit"
        },
        "overrides": []
      },
      "gridPos": { "h": 6, "w": 6, "x": 18, "y": 0 },
      "id": 4,
      "options": { "colorMode": "value", "graphMode": "none", "justifyMode": "auto", "orientation": "auto", "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false }, "textMode": "auto" },
      "pluginVersion": "8.0.0",
      "targets": [ { "expr": "avg_over_time(backup_last_status{job=\"db_backup\"}[7d])", "legendFormat": "{{instance}}", "refId": "A" } ],
      "title": "近 7 天成功率",
      "type": "stat"
    },
    {
      "datasource": "Prometheus",
      "description": "每次成功备份的 dump 大小",
      "fieldConfig": { "defaults": { "unit": "bytes" }, "overrides": [] },
      "gridPos": { "h": 9, "w": 12, "x": 0, "y": 6 },
      "id": 5,
      "options": { "legend": { "displayMode": "list", "placement": "bottom" }, "tooltip": { "mode": "single" } },
      "pluginVersion": "8.0.0",
      "targets": [ { "expr": "backup_size_bytes{job=\"db_backup\"}", "legendFormat": "{{instance}}", "refId": "A" } ],
      "title": "备份大小趋势",
      "type": "timeseries"
    },
    {
      "datasource": "Prometheus",
      "description": "备份与恢复演练耗时",
      "fieldConfig": { "defaults": { "unit": "s" }, "overrides": [] },
      "gridPos": { "h": 9, "w": 12, "x": 12, "y": 6 },
      "id": 6,
      "options": { "legend": { "displayMode": "list", "placement": "bottom" }, "tooltip": { "mode": "single" } },
      "pluginVersion": "8.0.0",
      "targets": [
        { "expr": "backup_duration_seconds{job=\"db_backup\"}", "legendFormat": "backup {{instance}}", "refId": "A" },
        { "expr": "restore_duration_seconds{job=\"db_restore_drill\"}", "legendFormat": "restore {{instance}}", "refId": "B" }
      ],
      "title": "备份 / 恢复耗时",
      "type": "timeseries"
    }
  ],
  "schemaVersion": 27,
  "style": "dark",
  "tags": ["backup", "postgres", "data-pipeline"],
  "templating": { "list": [] },
  "time": { "from": "now-7d", "to": "now" },
  "timepicker": {},
  "timezone": "",
  "title": "DB Backup",
  "uid": "db-backup",
  "version": 0
}
