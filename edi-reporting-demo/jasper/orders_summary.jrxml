<?xml version="1.0" encoding="UTF-8"?>
<!-- 订单汇总报表模板 (.jrxml)
     Jasper Reports 的报表定义本质是 XML：
     数据源(SQL查询) + 版式(标题/分组/明细) + 输出(PDF/Excel)
     用法: Jaspersoft Studio 打开本文件，数据源连 orders.db，预览即可导出 PDF。
-->
<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports"
              xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
              xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports
              http://jasperreports.sourceforge.net/xsd/jasperreport.xsd"
              name="OrdersSummary" pageWidth="595" pageHeight="842"
              columnWidth="555" leftMargin="20" rightMargin="20"
              topMargin="20" bottomMargin="20">

    <!-- 查询：按客户 + 仓库分组汇总（WMS 典型报表场景） -->
    <queryString>
        <![CDATA[
SELECT customer, warehouse,
       COUNT(*) AS line_count,
       SUM(qty) AS total_qty,
       ROUND(SUM(qty * unit_price), 2) AS amount
FROM orders
GROUP BY customer, warehouse
ORDER BY customer, warehouse
        ]]>
    </queryString>

    <field name="customer"   class="java.lang.String"/>
    <field name="warehouse"  class="java.lang.String"/>
    <field name="line_count" class="java.lang.Long"/>
    <field name="total_qty"  class="java.lang.Long"/>
    <field name="amount"     class="java.lang.Double"/>

    <title>
        <band height="50">
            <staticText>
                <reportElement x="0" y="10" width="300" height="30"/>
                <textElement fontSize="18" isBold="true"/>
                <text><![CDATA[订单汇总报表 (WMS Demo)]]></text>
            </staticText>
        </band>
    </title>

    <columnHeader>
        <band height="20">
            <staticText>
                <reportElement x="0" y="0" width="150" height="20"/>
                <textElement isBold="true"/>
                <text><![CDATA[客户]]></text>
            </staticText>
            <staticText>
                <reportElement x="150" y="0" width="120" height="20"/>
                <textElement isBold="true"/>
                <text><![CDATA[仓库]]></text>
            </staticText>
            <staticText>
                <reportElement x="270" y="0" width="80" height="20"/>
                <textElement isBold="true"/>
                <text><![CDATA[行数]]></text>
            </staticText>
            <staticText>
                <reportElement x="350" y="0" width="80" height="20"/>
                <textElement isBold="true"/>
                <text><![CDATA[总数量]]></text>
            </staticText>
            <staticText>
                <reportElement x="430" y="0" width="100" height="20"/>
                <textElement isBold="true"/>
                <text><![CDATA[金额]]></text>
            </staticText>
        </band>
    </columnHeader>

    <detail>
        <band height="20">
            <textField>
                <reportElement x="0" y="0" width="150" height="20"/>
                <textFieldExpression><![CDATA[$F{customer}]]></textFieldExpression>
            </textField>
            <textField>
                <reportElement x="150" y="0" width="120" height="20"/>
                <textFieldExpression><![CDATA[$F{warehouse}]]></textFieldExpression>
            </textField>
            <textField>
                <reportElement x="270" y="0" width="80" height="20"/>
                <textFieldExpression><![CDATA[$F{line_count}]]></textFieldExpression>
            </textField>
            <textField>
                <reportElement x="350" y="0" width="80" height="20"/>
                <textFieldExpression><![CDATA[$F{total_qty}]]></textFieldExpression>
            </textField>
            <textField>
                <reportElement x="430" y="0" width="100" height="20"/>
                <textFieldExpression><![CDATA[$F{amount}]]></textFieldExpression>
            </textField>
        </band>
    </detail>
</jasperReport>
